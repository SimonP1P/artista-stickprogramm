{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artista Stickprogramm",
  "version": "0.1.0",
  "identifier": "de.artista.stickprogramm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Artista Stickprogramm",
        "width": 1200,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 600,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "alphabete/*.ESB": "alphabete/",
      "alphabete/*.esb": "alphabete/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
